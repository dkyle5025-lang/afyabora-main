<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'AfyaBora Clinical Dashboard' %></title>
  <script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              primary: '#0f766e',
              primaryDark: '#115e59',
              secondary: '#38bdf8',
              accent: '#ecfeff',
              surface: '#f5fbfb',
              'surface-container-lowest': '#ffffff',
              'surface-container-low': '#ecfeff',
              'on-primary': '#ffffff',
              'on-secondary-container': '#0f172a',
              'on-surface': '#0f172a',
              'on-surface-variant': '#475569',
              'outline-variant': '#bae6fd',
              'primary-container': '#ccfbf1',
              'on-primary-container': '#134e4a'
            }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style>
    body {
      background: linear-gradient(135deg, #f0fdfa 0%, #f8fafc 100%);
      font-family: 'Inter', sans-serif;
    }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .table-glow { box-shadow: inset 0 1px 0 rgba(255,255,255,0.7); }
    .content-panel,
    .content-panel * {
      color: #0f766e !important;
    }
    .ui-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.9rem;
      padding: 0.7rem 1rem;
      border: 1px solid #dbeafe;
      background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
      color: #0f766e;
      font-size: 0.82rem;
      font-weight: 700;
      box-shadow: 0 6px 18px rgba(15, 118, 110, 0.08);
      transition: all 0.2s ease;
    }
    .ui-button:hover {
      transform: translateY(-1px);
      border-color: #99f6e4;
      background: linear-gradient(180deg, #ecfeff 0%, #f0fdfa 100%);
      color: #115e59;
    }
    .ui-button-primary {
      border-color: transparent;
      background: linear-gradient(135deg, #0f766e 0%, #06b6d4 100%);
      color: #fff;
      box-shadow: 0 10px 24px rgba(13, 148, 136, 0.2);
    }
    .ui-button-primary:hover {
      color: #fff;
      background: linear-gradient(135deg, #0f766e 0%, #0ea5e9 100%);
    }
    .info-card {
      border: 1px solid #e2e8f0;
      background: linear-gradient(180deg, #ffffff 0%, #f8fdff 100%);
      border-radius: 1.1rem;
      box-shadow: 0 10px 24px rgba(15, 118, 110, 0.05);
    }
  </style>
</head>
<body class="min-h-screen bg-surface text-on-surface">
  <div class="flex min-h-screen">
    <aside class="hidden w-72 flex-col justify-between bg-gradient-to-br from-teal-700 via-cyan-600 to-blue-800 px-5 py-6 text-white shadow-lg shadow-cyan-900/20 lg:flex">
      <div>
        <div class="mb-8 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 backdrop-blur-sm">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-white">
            <span class="material-symbols-outlined text-[28px]" style="font-variation-settings: 'FILL' 1;">medical_services</span>
          </div>
          <div>
            <p class="text-xl font-black tracking-tight">AfyaBora</p>
            <p class="text-xs text-slate-200/80">Clinical management</p>
          </div>
        </div>

        <div class="mb-6 rounded-2xl border border-teal-300/20 bg-white/5 p-3">
          <a href="/new-intake" class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-400 to-sky-500 px-4 py-3 text-sm font-bold text-slate-900 shadow-lg shadow-cyan-500/20 transition hover:brightness-110">
            <span class="material-symbols-outlined text-base">add</span>
            New Intake
          </a>
        </div>

        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold <%= activePage === 'dashboard' ? 'bg-white/10 text-white shadow-inner' : 'text-slate-200/80 hover:bg-white/5 hover:text-white' %>">
            <span class="material-symbols-outlined">dashboard</span>
            Dashboard
          </a>
          <a href="/patients/search" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold <%= activePage === 'patients' ? 'bg-white/10 text-white shadow-inner' : 'text-slate-200/80 hover:bg-white/5 hover:text-white' %>">
            <span class="material-symbols-outlined">search</span>
            Patient Search
          </a>
          <a href="/triage" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold <%= activePage === 'triage' ? 'bg-white/10 text-white shadow-inner' : 'text-slate-200/80 hover:bg-white/5 hover:text-white' %>">
            <span class="material-symbols-outlined">monitor_heart</span>
            Triage
          </a>
          <a href="/referrals" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold <%= activePage === 'referrals' ? 'bg-white/10 text-white shadow-inner' : 'text-slate-200/80 hover:bg-white/5 hover:text-white' %>">
            <span class="material-symbols-outlined">swap_horiz</span>
            Referrals
          </a>
        </nav>
      </div>

      <div class="space-y-2 border-t border-white/10 pt-4">
        <a href="/settings" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold <%= activePage === 'settings' ? 'bg-white/10 text-white' : 'text-slate-200/80 hover:bg-white/5 hover:text-white' %>">
          <span class="material-symbols-outlined">settings</span>
          Settings
        </a>
        <a href="/support" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold <%= activePage === 'support' ? 'bg-white/10 text-white' : 'text-slate-200/80 hover:bg-white/5 hover:text-white' %>">
          <span class="material-symbols-outlined">support_agent</span>
          Support
        </a>
        <a href="/logout" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white">
          <span class="material-symbols-outlined">logout</span>
          Logout
        </a>
      </div>
    </aside>

    <div class="flex-1 overflow-hidden">
      <header class="flex h-20 items-center justify-between border-b border-slate-200 bg-white/80 px-4 backdrop-blur-sm sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-teal-700 lg:hidden">
            <span class="material-symbols-outlined">menu</span>
          </div>
          <div class="relative hidden w-full max-w-md lg:block">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
            <input class="w-full rounded-full border border-slate-200 bg-slate-50 py-2.5 pl-10 pr-4 text-sm text-slate-700 outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-100" placeholder="Search patients, MRN, or phone number" type="text" />
          </div>
        </div>

        <div class="flex items-center gap-4">
          <button class="hidden rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700 sm:inline-flex sm:items-center sm:gap-2">
            <span class="material-symbols-outlined text-base">today</span>
            Today
          </button>
          <a href="/profile" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-2 py-2">
            <img alt="User profile" class="h-10 w-10 rounded-full object-cover ring-2 ring-white" src="<%= user && user.avatar ? user.avatar : 'https://via.placeholder.com/80' %>"/>
            <div class="hidden text-left md:block">
              <p class="text-sm font-bold text-slate-900"><%= user ? user.name : 'Guest' %></p>
              <p class="text-xs text-slate-500"><%= user ? user.role : 'Clinician' %></p>
            </div>
          </a>
        </div>
      </header>

      <main class="h-[calc(100vh-80px)] overflow-y-auto bg-slate-50 p-4 sm:p-6 lg:p-8">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700/70">Overview</p>
            <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900">Clinical Overview</h1>
          </div>
          <div class="flex items-center gap-3">
            <button class="ui-button ui-button-secondary">Export</button>
          </div>
        </div>

        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <div class="info-card p-5">
            <div class="mb-3 flex items-center justify-between">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Patients</p>
              <span class="material-symbols-outlined rounded-lg bg-teal-50 p-2 text-teal-700">groups</span>
            </div>
            <p class="text-3xl font-black text-slate-900"><%= totals.totalPatients || 0 %></p>
            <p class="mt-2 text-sm text-emerald-600">+12% this week</p>
          </div>

          <div class="info-card p-5">
            <div class="mb-3 flex items-center justify-between">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Triage</p>
              <span class="material-symbols-outlined rounded-lg bg-amber-50 p-2 text-amber-700">monitor_heart</span>
            </div>
            <p class="text-3xl font-black text-slate-900"><%= totals.todaysTriage || 0 %></p>
            <p class="mt-2 text-sm text-amber-600">Needs attention</p>
          </div>

          <div class="info-card p-5">
            <div class="mb-3 flex items-center justify-between">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Referrals</p>
              <span class="material-symbols-outlined rounded-lg bg-sky-50 p-2 text-sky-700">swap_horiz</span>
            </div>
            <p class="text-3xl font-black text-slate-900"><%= totals.referrals || 0 %></p>
            <p class="mt-2 text-sm text-sky-600">5 pending review</p>
          </div>

          <div class="info-card p-5">
            <div class="mb-3 flex items-center justify-between">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Waiting</p>
              <span class="material-symbols-outlined rounded-lg bg-rose-50 p-2 text-rose-700">pending_actions</span>
            </div>
            <p class="text-3xl font-black text-slate-900"><%= totals.waiting || 0 %></p>
            <p class="mt-2 text-sm text-rose-600">Avg. 18 minutes</p>
          </div>
        </section>

        <section class="mt-6 grid gap-6 xl:grid-cols-[1.6fr_0.9fr]">
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-5 py-4">
              <div>
                <h2 class="text-lg font-black text-slate-900">Recent triage intake</h2>
                <p class="text-sm text-slate-500">Most recent patient activity</p>
              </div>
              <button class="text-sm font-semibold text-teal-700">View full queue</button>
            </div>

            <div class="overflow-x-auto table-glow">
              <table class="min-w-full text-left">
                <thead class="bg-slate-50 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
                  <tr>
                    <th class="px-5 py-3">Patient ID</th>
                    <th class="px-5 py-3">Name</th>
                    <th class="px-5 py-3">Status</th>
                    <th class="px-5 py-3">Arrival</th>
                    <th class="px-5 py-3 text-right">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-sm text-slate-700">
                  <% (recentPatients || []).forEach(function(p){ %>
                    <tr class="transition hover:bg-slate-50">
                      <td class="px-5 py-4 font-semibold text-slate-900"><%= p.id %></td>
                      <td class="px-5 py-4"><%= p.name %></td>
                      <td class="px-5 py-4">
                        <span class="inline-flex items-center gap-2 rounded-full px-2.5 py-1 text-xs font-semibold <%= p.statusClass %>">
                          <span class="h-2 w-2 rounded-full <%= p.statusDotClass %>"></span>
                          <%= p.status %>
                        </span>
                      </td>
                      <td class="px-5 py-4 text-slate-500"><%= p.arrival %></td>
                      <td class="px-5 py-4 text-right">
                        <a href="/patients/<%= p.id %>" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-700 transition hover:bg-teal-50 hover:text-teal-700">
                          <span class="material-symbols-outlined text-lg">chevron_right</span>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="space-y-6">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="mb-4 flex items-center justify-between">
                <h2 class="text-lg font-black text-slate-900">Staff on duty</h2>
                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Online</span>
              </div>

              <div class="space-y-3">
                <% (staffOnDuty || []).forEach(function(s){ %>
                  <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3">
                    <div class="flex items-center gap-3">
                      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-gradient-to-br from-teal-500 to-cyan-500 text-sm font-black text-white"><%= s.initials %></div>
                      <div>
                        <p class="text-sm font-bold text-slate-900"><%= s.name %></p>
                        <p class="text-xs text-slate-500"><%= s.role %></p>
                      </div>
                    </div>
                    <span class="h-3 w-3 rounded-full <%= s.statusDot %>"></span>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-teal-600 to-cyan-600 p-5 text-white shadow-lg shadow-teal-500/20">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-teal-100">Performance</p>
              <p class="mt-4 text-4xl font-black">91%</p>
              <p class="mt-3 text-sm text-teal-50/90">Patient care workflow efficiency today</p>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
</body>
</html>