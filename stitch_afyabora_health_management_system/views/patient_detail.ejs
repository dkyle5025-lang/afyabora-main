<!DOCTYPE html>
<html class="h-full" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'Patient Details' %></title>
  <script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              primary: '#2563eb',
              secondary: '#60a5fa',
              'secondary-container': '#dbeafe',
              surface: '#f8fbff',
              'surface-container-lowest': '#ffffff',
              'surface-container-low': '#eff6ff',
              'on-primary': '#ffffff',
              'on-secondary-container': '#1d4ed8',
              'on-surface': '#0f172a',
              'on-surface-variant': '#475569',
              'outline-variant': '#bfdbfe',
              'primary-container': '#dbeafe',
              'on-primary-container': '#1d4ed8'
            }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style>body { background: linear-gradient(135deg, #eff6ff 0%, #f8fbff 100%); }</style>
</head>
<body class="h-full bg-surface text-on-surface font-body-md flex overflow-hidden">
  <nav class="hidden lg:flex flex-col h-full py-lg bg-gradient-to-b from-teal-700 via-cyan-600 to-blue-800 text-white w-64 flex-shrink-0 shadow-lg shadow-cyan-900/20">
    <div class="px-lg mb-8 flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-secondary flex items-center justify-center text-on-secondary font-bold">AB</div>
      <div>
        <h1 class="font-headline-sm text-headline-sm font-bold">AfyaBora</h1>
        <p class="font-label-bold text-label-bold opacity-80 mt-1">Clinical Management</p>
      </div>
    </div>
    <div class="px-3 space-y-2">
      <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg <%= activePage === 'dashboard' ? 'text-on-secondary-container bg-secondary-container' : 'text-on-primary hover:bg-blue-700' %>"><span class="material-symbols-outlined text-lg">dashboard</span> Dashboard</a>
      <a href="/patients/search" class="flex items-center gap-3 px-4 py-3 rounded-lg <%= activePage === 'patients' ? 'text-on-secondary-container bg-secondary-container' : 'text-on-primary hover:bg-blue-700' %>"><span class="material-symbols-outlined text-lg">search</span> Patient Search</a>
      <a href="/triage" class="flex items-center gap-3 px-4 py-3 rounded-lg <%= activePage === 'triage' ? 'text-on-secondary-container bg-secondary-container' : 'text-on-primary hover:bg-blue-700' %>"><span class="material-symbols-outlined text-lg">medical_services</span> Triage</a>
      <a href="/referrals" class="flex items-center gap-3 px-4 py-3 rounded-lg <%= activePage === 'referrals' ? 'text-on-secondary-container bg-secondary-container' : 'text-on-primary hover:bg-blue-700' %>"><span class="material-symbols-outlined text-lg">swap_horiz</span> Referrals</a>
      <div class="mt-8 pt-4 border-t border-blue-300">
        <a href="/settings" class="flex items-center gap-3 px-4 py-3 rounded-lg <%= activePage === 'settings' ? 'text-on-secondary-container bg-secondary-container' : 'text-on-primary hover:bg-blue-700' %>"><span class="material-symbols-outlined text-lg">settings</span> Settings</a>
        <a href="/support" class="flex items-center gap-3 px-4 py-3 rounded-lg <%= activePage === 'support' ? 'text-on-secondary-container bg-secondary-container' : 'text-on-primary hover:bg-blue-700' %>"><span class="material-symbols-outlined text-lg">support_agent</span> Support</a>
        <a href="/profile" class="flex items-center gap-3 px-4 py-3 rounded-lg <%= activePage === 'profile' ? 'text-on-secondary-container bg-secondary-container' : 'text-on-primary hover:bg-blue-700' %>"><span class="material-symbols-outlined text-lg">person</span> Profile</a>
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-primary hover:bg-blue-700"><span class="material-symbols-outlined text-lg">logout</span> Logout</a>
      </div>
    </div>
  </nav>

  <div class="flex-1 flex flex-col h-full overflow-hidden">
    <header class="flex justify-between items-center px-lg h-16 w-full sticky top-0 z-40 bg-surface-container-lowest border-b border-outline-variant">
      <div class="hidden lg:block flex-1"></div>
      <div class="flex items-center gap-4">
        <button class="p-2 rounded-full hover:bg-surface-container-low"><span class="material-symbols-outlined">notifications</span></button>
        <a href="/profile" class="flex items-center gap-2 rounded-full border border-outline-variant bg-surface-container-low px-3 py-2">
          <span class="material-symbols-outlined">account_circle</span>
          <span class="font-medium"><%= user ? user.name : 'Clinician' %></span>
        </a>
      </div>
    </header>

    <main class="flex-1 overflow-y-auto p-md lg:p-xl">
      <div class="max-w-6xl mx-auto w-full">
        <div class="mb-6 flex justify-between items-center">
          <div>
            <h2 class="text-3xl font-bold text-blue-700">Patient Details</h2>
            <p class="text-slate-600 mt-1">Clinical profile and care summary</p>
          </div>
          <a href="/patients/search" class="bg-blue-700 text-white px-4 py-2 rounded-lg hover:bg-blue-800">Back to Search</a>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="md:col-span-2 bg-white border border-blue-200 rounded-xl p-6 shadow-sm">
            <div class="flex items-center justify-between pb-4 border-b border-blue-100 mb-4">
              <div>
                <p class="text-sm uppercase tracking-wide text-slate-500">Patient</p>
                <h3 class="text-2xl font-bold"><%= patient.name %></h3>
              </div>
              <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm font-semibold"><%= patient.triageLevel %></span>
            </div>

            <div class="grid sm:grid-cols-2 gap-4 text-sm">
              <div><span class="text-slate-500">Patient ID</span><p class="font-semibold"><%= patient.id %></p></div>
              <div><span class="text-slate-500">Gender</span><p class="font-semibold"><%= patient.gender %></p></div>
              <div><span class="text-slate-500">Age</span><p class="font-semibold"><%= patient.age %></p></div>
              <div><span class="text-slate-500">DOB</span><p class="font-semibold"><%= patient.dob %></p></div>
              <div><span class="text-slate-500">Phone</span><p class="font-semibold"><%= patient.phone %></p></div>
              <div><span class="text-slate-500">Hospital</span><p class="font-semibold"><%= patient.hospital %></p></div>
            </div>
          </div>

          <div class="bg-white border border-blue-200 rounded-xl p-6 shadow-sm">
            <p class="text-sm uppercase tracking-wide text-slate-500 mb-2">Status</p>
            <p class="text-lg font-bold text-blue-700"><%= patient.condition %></p>
            <div class="mt-6">
              <p class="text-sm uppercase tracking-wide text-slate-500">Last Visit</p>
              <p class="font-semibold"><%= patient.lastVisit %></p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
