<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'Referrals - AfyaBora' %></title>
  <script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              primary: '#0f766e',
              primaryDark: '#115e59',
              secondary: '#38bdf8',
              accent: '#ecfeff',
              surface: '#f5fbfb',
              'surface-container-lowest': '#ffffff',
              'surface-container-low': '#ecfeff',
              'on-primary': '#ffffff',
              'on-secondary-container': '#0f172a',
              'on-surface': '#0f172a',
              'on-surface-variant': '#475569',
              'outline-variant': '#bae6fd',
              'primary-container': '#ccfbf1',
              'on-primary-container': '#134e4a'
            }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style>
    body { background: linear-gradient(135deg, #f0fdfa 0%, #f8fafc 100%); font-family: 'Inter', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .ui-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.9rem;
      padding: 0.72rem 1rem;
      border: 1px solid #dbeafe;
      background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
      color: #0f766e;
      font-size: 0.82rem;
      font-weight: 700;
      box-shadow: 0 6px 18px rgba(15, 118, 110, 0.08);
      transition: all 0.2s ease;
    }
    .ui-button:hover {
      transform: translateY(-1px);
      border-color: #99f6e4;
      background: linear-gradient(180deg, #ecfeff 0%, #f0fdfa 100%);
      color: #115e59;
    }
    .ui-button-primary {
      border-color: transparent;
      background: linear-gradient(135deg, #0f766e 0%, #06b6d4 100%);
      color: #fff;
      box-shadow: 0 10px 24px rgba(13, 148, 136, 0.2);
    }
    .ui-button-primary:hover {
      color: #fff;
      background: linear-gradient(135deg, #0f766e 0%, #0ea5e9 100%);
    }
  </style>
</head>
<body class="min-h-screen bg-surface text-on-surface">
  <div class="flex min-h-screen">
    <aside class="hidden w-72 flex-col justify-between bg-gradient-to-br from-teal-700 via-cyan-600 to-blue-800 px-5 py-6 text-white shadow-lg shadow-cyan-900/20 lg:flex">
      <div>
        <div class="mb-8 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 backdrop-blur-sm">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10"><span class="material-symbols-outlined text-[28px]" style="font-variation-settings: 'FILL' 1;">medical_services</span></div>
          <div>
            <p class="text-xl font-black tracking-tight">AfyaBora</p>
            <p class="text-xs text-slate-200/80">Clinical management</p>
          </div>
        </div>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">dashboard</span> Dashboard</a>
          <a href="/patients/search" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">search</span> Patient Search</a>
          <a href="/triage" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">monitor_heart</span> Triage</a>
          <a href="/referrals" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold bg-white/10 text-white shadow-inner"><span class="material-symbols-outlined">swap_horiz</span> Referrals</a>
        </nav>
      </div>
      <div class="space-y-2 border-t border-white/10 pt-4">
        <a href="/settings" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">settings</span> Settings</a>
        <a href="/support" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">support_agent</span> Support</a>
        <a href="/profile" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">person</span> Profile</a>
        <a href="/logout" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">logout</span> Logout</a>
      </div>
    </aside>

    <div class="flex-1 overflow-hidden">
      <header class="flex h-20 items-center justify-between border-b border-slate-200 bg-white/80 px-4 backdrop-blur-sm sm:px-6 lg:px-8">
        <div class="hidden lg:block"></div>
        <div class="ml-auto flex items-center gap-4">
          <button class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">Alerts</button>
          <a href="/profile" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-2 py-2">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-teal-500 to-cyan-500 text-sm font-black text-white">CL</div>
            <div class="hidden text-left md:block">
              <p class="text-sm font-bold text-slate-900"><%= user ? user.name : 'Clinician' %></p>
              <p class="text-xs text-slate-500"><%= user ? user.role : 'User' %></p>
            </div>
          </a>
        </div>
      </header>

      <main class="h-[calc(100vh-80px)] overflow-y-auto bg-slate-50 p-4 sm:p-6 lg:p-8">
        <div class="mx-auto max-w-6xl">
          <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700/70">Queue</p>
              <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900">Referral Queue</h1>
            </div>
            <a href="/new-intake" class="ui-button ui-button-primary">New referral</a>
          </div>

          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-5 py-4">
              <h2 class="text-lg font-black text-slate-900">Outgoing referrals</h2>
              <span class="rounded-full bg-teal-50 px-2.5 py-1 text-xs font-semibold text-teal-700"><%= (referrals || []).length %> active</span>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full text-left">
                <thead class="bg-slate-50 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
                  <tr>
                    <th class="px-5 py-3">Referral ID</th>
                    <th class="px-5 py-3">Patient</th>
                    <th class="px-5 py-3">Specialty</th>
                    <th class="px-5 py-3">Urgency</th>
                    <th class="px-5 py-3">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                  <% (referrals || []).forEach(function(ref){ %>
                    <tr class="transition hover:bg-slate-50">
                      <td class="px-5 py-4 font-semibold text-teal-700"><%= ref.id %></td>
                      <td class="px-5 py-4 font-medium text-slate-800"><%= ref.patient %></td>
                      <td class="px-5 py-4 text-slate-700"><%= ref.specialty %></td>
                      <td class="px-5 py-4"><span class="rounded-full bg-sky-100 px-2.5 py-1 text-xs font-semibold text-sky-700"><%= ref.urgency %></span></td>
                      <td class="px-5 py-4"><span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= ref.status %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
