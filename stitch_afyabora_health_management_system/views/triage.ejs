<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'AfyaBora - Triage' %></title>
  <script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              primary: '#0f766e',
              primaryDark: '#115e59',
              secondary: '#38bdf8',
              accent: '#ecfeff',
              surface: '#f5fbfb',
              'surface-container-lowest': '#ffffff',
              'surface-container-low': '#ecfeff',
              'on-primary': '#ffffff',
              'on-secondary-container': '#0f172a',
              'on-surface': '#0f172a',
              'on-surface-variant': '#475569',
              'outline-variant': '#bae6fd',
              'primary-container': '#ccfbf1',
              'on-primary-container': '#134e4a'
            }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style>
    body { background: linear-gradient(135deg, #f0fdfa 0%, #f8fafc 100%); font-family: 'Inter', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .medical-input { width: 100%; border: 1px solid #bae6fd; border-radius: 1rem; background: white; padding: 0.8rem 0.9rem; color: #0f172a; transition: all 0.2s ease; }
    .medical-input:focus { outline: none; border-color: #0f766e; box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.12); }
    .content-panel,
    .content-panel * {
      color: #0f766e !important;
    }
    .ui-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.9rem;
      padding: 0.72rem 1rem;
      border: 1px solid #dbeafe;
      background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
      color: #0f766e;
      font-size: 0.82rem;
      font-weight: 700;
      box-shadow: 0 6px 18px rgba(15, 118, 110, 0.08);
      transition: all 0.2s ease;
    }
    .ui-button:hover {
      transform: translateY(-1px);
      border-color: #99f6e4;
      background: linear-gradient(180deg, #ecfeff 0%, #f0fdfa 100%);
      color: #115e59;
    }
    .ui-button-primary {
      border-color: transparent;
      background: linear-gradient(135deg, #0f766e 0%, #06b6d4 100%);
      color: #fff;
      box-shadow: 0 10px 24px rgba(13, 148, 136, 0.2);
    }
    .ui-button-primary:hover {
      color: #fff;
      background: linear-gradient(135deg, #0f766e 0%, #0ea5e9 100%);
    }
  </style>
</head>
<body class="min-h-screen bg-surface text-on-surface">
  <div class="flex min-h-screen">
    <aside class="hidden w-72 flex-col justify-between bg-gradient-to-br from-teal-700 via-cyan-600 to-blue-800 px-5 py-6 text-white shadow-lg shadow-cyan-900/20 lg:flex">
      <div>
        <div class="mb-8 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 backdrop-blur-sm">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10"><span class="material-symbols-outlined text-[28px]" style="font-variation-settings: 'FILL' 1;">medical_services</span></div>
          <div>
            <p class="text-xl font-black tracking-tight">AfyaBora</p>
            <p class="text-xs text-slate-200/80">Clinical management</p>
          </div>
        </div>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">dashboard</span> Dashboard</a>
          <a href="/patients/search" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">search</span> Patient Search</a>
          <a href="/triage" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold bg-white/10 text-white shadow-inner"><span class="material-symbols-outlined">monitor_heart</span> Triage</a>
          <a href="/referrals" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">swap_horiz</span> Referrals</a>
        </nav>
      </div>
      <div class="space-y-2 border-t border-white/10 pt-4">
        <a href="/settings" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">settings</span> Settings</a>
        <a href="/support" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">support_agent</span> Support</a>
        <a href="/profile" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">person</span> Profile</a>
        <a href="/logout" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-slate-200/80 hover:bg-white/5 hover:text-white"><span class="material-symbols-outlined">logout</span> Logout</a>
      </div>
    </aside>

    <div class="flex-1 overflow-hidden">
      <header class="flex h-20 items-center justify-between border-b border-slate-200 bg-white/80 px-4 backdrop-blur-sm sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-teal-700 lg:hidden">
            <span class="material-symbols-outlined">menu</span>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <button class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700">Alerts</button>
          <a href="/profile" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-2 py-2">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-teal-500 to-cyan-500 text-sm font-black text-white">DR</div>
            <div class="hidden text-left md:block">
              <p class="text-sm font-bold text-slate-900">Clinician</p>
              <p class="text-xs text-slate-500">Triage lead</p>
            </div>
          </a>
        </div>
      </header>

      <main class="h-[calc(100vh-80px)] overflow-y-auto bg-slate-50 p-4 sm:p-6 lg:p-8">
        <div class="mx-auto max-w-6xl">
          <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700/70">Assessment</p>
              <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900">Intake & Triage</h1>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-teal-700"><span class="material-symbols-outlined">person</span></div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Patient</p>
                <p class="text-lg font-black text-slate-900"><%= patient ? patient.name : '—' %></p>
              </div>
              <div class="hidden h-10 w-px bg-slate-200 sm:block"></div>
              <div class="hidden sm:block">
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">MRN</p>
                <p class="text-sm font-semibold text-slate-700"><%= patient ? patient.mrn : '—' %></p>
              </div>
            </div>
          </div>

          <form class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" action="/triage" method="post">
            <div class="border-b border-slate-200 bg-slate-50 px-5 py-4">
              <h2 class="flex items-center gap-2 text-lg font-black text-slate-900"><span class="material-symbols-outlined text-teal-700">assignment</span> Presentation</h2>
            </div>
            <div class="p-5 sm:p-6">
              <label class="mb-2 block text-sm font-semibold text-slate-700" for="chiefComplaint">Chief Complaint</label>
              <textarea id="chiefComplaint" name="chiefComplaint" class="medical-input resize-y" rows="2"><%= triage ? triage.chiefComplaint : '' %></textarea>
            </div>

            <div class="border-t border-slate-200 bg-slate-50 px-5 py-4">
              <h2 class="flex items-center gap-2 text-lg font-black text-slate-900"><span class="material-symbols-outlined text-teal-700">vital_signs</span> Vital Signs</h2>
            </div>
            <div class="grid gap-4 p-5 sm:grid-cols-2 lg:grid-cols-5 sm:p-6">
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="temp">Temp</label>
                <input id="temp" name="temp" value="<%= triage ? triage.temp : '' %>" class="medical-input"/>
              </div>
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="bp">BP</label>
                <input id="bp" name="bp" value="<%= triage ? triage.bp : '' %>" class="medical-input"/>
              </div>
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="pulse">Pulse</label>
                <input id="pulse" name="pulse" value="<%= triage ? triage.pulse : '' %>" class="medical-input"/>
              </div>
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="resp">Resp. Rate</label>
                <input id="resp" name="resp" value="<%= triage ? triage.resp : '' %>" class="medical-input"/>
              </div>
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="spo2">SpO2</label>
                <input id="spo2" name="spo2" value="<%= triage ? triage.spo2 : '' %>" class="medical-input"/>
              </div>
            </div>

            <div class="border-t border-slate-200 bg-slate-50 px-5 py-4">
              <h2 class="flex items-center gap-2 text-lg font-black text-slate-900"><span class="material-symbols-outlined text-teal-700">stethoscope</span> Diagnosis & Symptoms</h2>
            </div>
            <div class="grid gap-4 p-5 sm:p-6">
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="diagnosis">Diagnosis</label>
                <textarea id="diagnosis" name="diagnosis" class="medical-input resize-y" rows="3"><%= triage ? triage.diagnosis : '' %></textarea>
              </div>
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="symptoms">Clinical Observations</label>
                <textarea id="symptoms" name="symptoms" class="medical-input resize-y" rows="4"><%= triage ? triage.symptoms : '' %></textarea>
              </div>
            </div>

            <div class="border-t border-slate-200 bg-slate-50 px-5 py-4">
              <h2 class="flex items-center gap-2 text-lg font-black text-slate-900"><span class="material-symbols-outlined text-teal-700">flag</span> Acuity Category</h2>
            </div>
            <div class="grid gap-4 p-5 sm:grid-cols-2 xl:grid-cols-4 sm:p-6">
              <% ['red','yellow','green','black'].forEach(function(level){ %>
                <label class="cursor-pointer">
                  <input class="sr-only" name="triageCategory" type="radio" value="<%= level %>" <%= triage && triage.triageCategory===level ? 'checked' : '' %> />
                  <div class="h-full rounded-2xl border border-slate-200 bg-slate-50 p-4 transition hover:border-teal-300 hover:bg-teal-50">
                    <div class="mb-2 flex items-center gap-2">
                      <div class="h-4 w-4 rounded-full border border-slate-200" style="background-color: <%= level==='red'? '#ef4444' : level==='yellow'? '#f59e0b' : level==='green'? '#22c55e' : '#111827' %>;"></div>
                      <span class="text-sm font-bold uppercase tracking-[0.15em] text-slate-700">Level <%= ['red','yellow','green','black'].indexOf(level)+1 %></span>
                    </div>
                    <p class="text-sm font-semibold text-slate-800"><%= level.charAt(0).toUpperCase()+level.slice(1) %></p>
                    <p class="mt-2 text-sm text-slate-600"><%= level==='red' ? 'Immediate intervention required.' : level==='yellow' ? 'High-risk, urgent assessment.' : level==='green' ? 'Stable, monitor and treat.' : 'Expectant or deceased.' %></p>
                  </div>
                </label>
              <% }) %>
            </div>

            <div class="flex justify-end gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4">
              <button type="button" class="ui-button">Clear</button>
              <button type="submit" name="submitAction" value="submitResults" class="ui-button ui-button-primary">Submit results</button>
            </div>
          </form>

          <% if (triage && triage.aiAssessment) { %>
            <section class="mt-6 rounded-2xl border border-teal-200 bg-gradient-to-br from-teal-50 to-cyan-50 p-5 shadow-sm sm:p-6">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-teal-700">AI assessment</p>
                  <h3 class="mt-1 text-2xl font-black text-slate-900">Level <%= triage.aiAssessment.level.toUpperCase() %></h3>
                </div>
                <div class="inline-flex rounded-full bg-white px-3 py-1.5 text-sm font-bold text-teal-700 ring-1 ring-teal-200"> <%= triage.aiAssessment.level === 'red' ? 'Immediate' : triage.aiAssessment.level === 'yellow' ? 'Urgent' : 'Stable' %> </div>
              </div>
              <div class="mt-4 grid gap-4 md:grid-cols-3">
                <div class="rounded-2xl border border-white/60 bg-white/70 p-4">
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Summary</p>
                  <p class="mt-2 text-sm font-semibold text-slate-800"><%= triage.aiAssessment.summary %></p>
                </div>
                <div class="rounded-2xl border border-white/60 bg-white/70 p-4">
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Risk score</p>
                  <p class="mt-2 text-3xl font-black text-teal-700"><%= triage.aiAssessment.score %></p>
                </div>
                <div class="rounded-2xl border border-white/60 bg-white/70 p-4">
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Interpretation</p>
                  <p class="mt-2 text-sm font-semibold text-slate-800"><%= triage.aiAssessment.level === 'red' ? 'Requires immediate emergency response.' : triage.aiAssessment.level === 'yellow' ? 'Requires rapid clinical review and escalation.' : 'Routine monitoring is sufficient for now.' %></p>
                </div>
              </div>
            </section>
          <% } %>
        </div>
      </main>
    </div>
  </div>
</body>
</html>