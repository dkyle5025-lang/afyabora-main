<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'AfyaBora - Login' %></title>
  <script>
    tailwind = {
      config: {
        theme: {
          extend: {
            colors: {
              primary: '#0f766e',
              primaryDark: '#115e59',
              secondary: '#38bdf8',
              accent: '#e0f2fe',
              success: '#22c55e',
              surface: '#f4fbfb',
              'surface-container-lowest': '#ffffff',
              'surface-container-low': '#ecfeff',
              'on-primary': '#ffffff',
              'on-secondary-container': '#0f172a',
              'on-surface': '#0f172a',
              'on-surface-variant': '#475569',
              'outline-variant': '#bae6fd',
              'primary-container': '#ccfbf1',
              'on-primary-container': '#134e4a'
            }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <style>
    body {
      background:
        radial-gradient(circle at top left, rgba(13, 148, 136, 0.12), transparent 32%),
        radial-gradient(circle at bottom right, rgba(56, 189, 248, 0.16), transparent 30%),
        linear-gradient(135deg, #f0fdfa 0%, #f8fafc 100%);
      font-family: 'Inter', sans-serif;
    }
    .glass-card {
      background: rgba(255,255,255,0.88);
      border: 1px solid rgba(14,116,144,0.12);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      box-shadow: 0 24px 80px rgba(15, 118, 110, 0.12);
    }
    .content-panel,
    .content-panel * {
      color: #0f766e !important;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8 text-on-surface">
  <main class="w-full max-w-6xl overflow-hidden rounded-[32px] border border-slate-200/80 bg-white/70 shadow-[0_35px_120px_rgba(15,23,42,0.12)]">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] min-h-[760px]">
      <section class="relative hidden lg:flex flex-col justify-between overflow-hidden bg-gradient-to-br from-primary via-primaryDark to-slate-900 p-10 text-white">
        <div class="absolute inset-0 opacity-30">
          <div class="absolute -left-16 top-12 h-72 w-72 rounded-full bg-cyan-300/40 blur-3xl"></div>
          <div class="absolute right-8 bottom-6 h-60 w-60 rounded-full bg-teal-300/30 blur-3xl"></div>
        </div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/5 px-3 py-2 backdrop-blur-sm">
            <span class="material-symbols-outlined text-lg">medical_services</span>
            <span class="text-sm font-semibold tracking-[0.18em] uppercase text-teal-50/90">AfyaBora</span>
          </div>
        </div>

        <div class="relative z-10">
          <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-teal-100/80">Clinical Excellence</p>
          <h1 class="max-w-md text-5xl font-black leading-tight tracking-tight">Smart care for every patient journey.</h1>
          <p class="mt-6 max-w-md text-lg text-slate-200/90">
            Centralize intake, triage, referrals, and follow-up workflows in one secure, patient-centered platform.
          </p>
        </div>

        <div class="relative z-10 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
            <p class="text-3xl font-black">24/7</p>
            <p class="text-sm text-slate-200/80">Monitoring</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
            <p class="text-3xl font-black">1284</p>
            <p class="text-sm text-slate-200/80">Patients</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
            <p class="text-3xl font-black">18</p>
            <p class="text-sm text-slate-200/80">Referrals</p>
          </div>
        </div>
      </section>

      <section class="flex items-center justify-center bg-slate-50/80 p-6 sm:p-10">
        <div class="glass-card w-full max-w-md rounded-[28px] p-6 sm:p-8">
          <div class="mb-8 flex items-center justify-between gap-3">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-700/70">Welcome back</p>
              <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-900">Sign in</h2>
            </div>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-teal-500 to-cyan-500 text-white shadow-lg shadow-teal-500/30">
              <span class="material-symbols-outlined text-[30px]" style="font-variation-settings: 'FILL' 1;">local_hospital</span>
            </div>
          </div>

          <div class="mb-6 flex items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700">
            <span class="material-symbols-outlined text-base">verified_user</span>
            <span>Secure connection established</span>
          </div>

          <form class="space-y-5" action="/login" method="post">
            <div>
              <label class="mb-2 block text-sm font-semibold text-slate-700" for="username">Username</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">person</span>
                <input id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" class="w-full rounded-2xl border border-slate-200 bg-white py-3.5 pl-11 pr-3 text-base text-slate-800 shadow-sm outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-100" placeholder="Enter your clinical ID" required type="text" />
              </div>
            </div>

            <div>
              <div class="mb-2 flex items-center justify-between">
                <label class="text-sm font-semibold text-slate-700" for="password">Password</label>
                <a class="text-sm font-semibold text-teal-700 hover:text-teal-800" href="#">Forgot password?</a>
              </div>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">lock</span>
                <input id="password" name="password" class="w-full rounded-2xl border border-slate-200 bg-white py-3.5 pl-11 pr-3 text-base text-slate-800 shadow-sm outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-100" placeholder="Enter your password" required type="password" />
              </div>
            </div>

            <button class="flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-teal-600 to-cyan-500 px-5 py-3.5 text-base font-bold text-white shadow-lg shadow-teal-500/20 transition hover:brightness-110 active:scale-[0.99]" type="submit">
              <span>Access dashboard</span>
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </button>
          </form>

          <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-100/70 p-4">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Demo access</p>
                <p class="mt-1 text-sm text-slate-700">Use any username with any valid password</p>
              </div>
              <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">Ready</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</body>
</html>